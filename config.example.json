{
  "report_settings": {
    "report_hours": true,
    "tag_environment": true,
    "env_default": "dev",
    "env_map": {
      "prod": ["main", "master"],
      "stage": ["release", "staging"],
      "dev": ["development", "develop", "dev"]
    },
    "total_hours": 160,
    "month": 1,
    "year": 2026,
    "responsible_name": "Full Name",
    "author_emails": ["you@company.com"],
    "exclude_pr_merge_commits": true,
    "exclude_environment_sync_merges": true,
    "ai_provider": "gemini",
    "summary_model": "gemini-2.5-flash",
    "paraphrase_model": "gemini-2.5-flash",
    "write_ai_debug_file": true,
    "calendar_timezone": "America/Mexico_City",
    "commit_date_basis": "committer"
  },
  "projects": [
    {
      "name": "ExampleProject",
      "hours": 80,
      "repos": ["/absolute/path/to/repository-one"],
      "extra_tasks": [
        {
          "category": "Administration",
          "description": "Brief description of an optional extra task."
        }
      ]
    },
    {
      "name": "AnotherProject",
      "repos": [
        "/absolute/path/to/repository-two",
        {
          "path": "/absolute/path/to/repository-three",
          "author_emails": ["you@company.com"],
          "exclude_pr_merge_commits": true
        }
      ],
      "extra_tasks": []
    }
  ]
}
